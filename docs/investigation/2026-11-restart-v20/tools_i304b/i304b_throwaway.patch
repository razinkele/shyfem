 !*******************************************************************
 !*******************************************************************
 
+
+!*******************************************************************
+! I304 THROWAWAY: k-eps state (tken, eps, visv, difv) in the v20 record
+!*******************************************************************
+
+	subroutine i304_keps_rst(iunit,mode)
+
+	use mod_keps
+	use mod_diff_visc_fric
+	use mod_restart
+
+	implicit none
+
+	integer, intent(in) :: iunit
+	integer, intent(in) :: mode	!1 write, 2 read, 3 skip
+	logical, parameter :: bn = .false.
+	integer i,ios
+
+	if( mode == 1 ) then
+	  call restart_write_value(iunit,bn,tken)
+	  call restart_write_value(iunit,bn,eps)
+	  call restart_write_value(iunit,bn,visv)
+	  call restart_write_value(iunit,bn,difv)
+	else if( mode == 2 ) then
+	  call restart_read_value(iunit,bn,tken)
+	  call restart_read_value(iunit,bn,eps)
+	  call restart_read_value(iunit,bn,visv)
+	  call restart_read_value(iunit,bn,difv)
+	  allocate(visv_i304(size(visv,1),size(visv,2)),difv_i304(size(difv,1),size(difv,2)),stat=ios)
+	  if( ios /= 0 ) stop 'error stop: allocation failed'
+	  visv_i304 = visv
+	  difv_i304 = difv
+	  brst_keps_i304 = .true.
+	  write(6,*) 'I304: k-eps state restored'
+	else
+	  do i=1,4
+	    read(iunit,iostat=ios)
+	  end do
+	  write(6,*) 'I304: k-eps state skipped'
+	end if
+
+	end subroutine i304_keps_rst
+
+!*******************************************************************
+
+	subroutine i304_keps_apply	!I304 THROWAWAY: after init_others
+
+	use mod_keps
+	use mod_diff_visc_fric
+
+	implicit none
+
+	if( .not. brst_keps_i304 ) return
+	visv = visv_i304
+	difv = difv_i304
+	write(6,*) 'I304: k-eps visv/difv re-applied after init_others'
+
+	end subroutine i304_keps_apply
