+!******************************************************************
+
+	subroutine lgr_dbg_dtgrad(lmax,hl,wd,dtd)
+
+! DEBUG mwalk (throwaway, never committed): random walk step criteria with
+! a gradient term, per layer l of the column (K' = (K(l)-K(l-1))/hl(l)):
+!   bit 1: dt <= facv * Kmin / K'**2  (Visser: drift K' dt small against
+!          the scale K/K' of K)
+!   bit 2: dt <= (facs * hl)**2 / (2 Kmax)  (sqrt(2 K dt) <= facs * hl)
+!   bit 4: dt <= facd * hl / |K'|  (drift K' dt <= facd * hl)
+! dtd is lowered to the smallest of the selected criteria
+
+	use mod_lagrange
+
+	implicit none
+
+	integer, intent(in)	:: lmax
+	real, intent(in)	:: hl(lmax)
+	real, intent(in)	:: wd(0:lmax)
+	real, intent(inout)	:: dtd
+
+	integer :: l
+	double precision :: dk,kmin,kmax,dtl
+
+	do l = 1,lmax
+	  if( hl(l) <= 0. ) cycle
+	  dk = (dble(wd(l))-dble(wd(l-1)))/hl(l)
+	  kmin = max(1.d-6,dble(min(wd(l-1),wd(l))))
+	  kmax = max(1.d-6,dble(max(wd(l-1),wd(l))))
+	  if( iand(lgr_dbg_dtcrit,1) /= 0 ) then
+	    if( dk /= 0.d0 ) then
+	      dtl = lgr_dbg_facv*kmin/(dk*dk)
+	      if( dtl < dtd ) dtd = real(dtl)
+	    end if
+	  end if
+	  if( iand(lgr_dbg_dtcrit,2) /= 0 ) then
+	    dtl = (lgr_dbg_facs*hl(l))**2/(2.d0*kmax)
+	    if( dtl < dtd ) dtd = real(dtl)
+	  end if
+	  if( iand(lgr_dbg_dtcrit,4) /= 0 ) then
+	    if( dk /= 0.d0 ) then
+	      dtl = lgr_dbg_facd*hl(l)/abs(dk)
+	      if( dtl < dtd ) dtd = real(dtl)
+	    end if
+	  end if
+	end do
+
+	end subroutine lgr_dbg_dtgrad
+
 !******************************************************************
 ! Horizontal diffusion of body id
 
