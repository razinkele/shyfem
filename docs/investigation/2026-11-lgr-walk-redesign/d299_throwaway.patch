 !************************************************************
 
+
+!************************************************************
+
+	subroutine d299_putback(ie,lb,lmax)
+
+! throwaway diagnostic #299 (never committed): counts a particle put
+! back into element ie at a side whose neighbour lacks its layer lb
+! (d299_n(3,ie) in the bottom layer, d299_n(4,ie) above it)
+
+	use mod_lagrange
+
+	implicit none
+
+	integer, intent(in) :: ie,lb,lmax
+
+	if( .not. allocated(d299_n) ) return
+	if( ie < 1 ) return
+	if( lb == lmax ) then
+!$OMP ATOMIC
+	  d299_n(3,ie) = d299_n(3,ie) + 1
+	else
+!$OMP ATOMIC
+	  d299_n(4,ie) = d299_n(4,ie) + 1
+	end if
+
+	end
+
+!************************************************************
+
+	subroutine d299_wif(ie,lb,lmax,sv,wtop,wbot)
+
+! throwaway variant #299 (never committed): element-mean interface
+! velocities (old and new time level) at the top and bottom of layer lb,
+! 0 at the element's bed, minus the sinking velocity
+
+	use mod_hydro_vel, only : wlov, wlnv
+	use basin, only : nen3v
+
+	implicit none
+
+	integer, intent(in) :: ie,lb,lmax
+	double precision, intent(in) :: sv
+	double precision, intent(out) :: wtop,wbot
+
+	integer ii,k
+
+	wtop = 0.d0
+	wbot = 0.d0
+	do ii=1,3
+	  k = nen3v(ii,ie)
+	  wtop = wtop + 0.5d0*(wlov(lb-1,k)+wlnv(lb-1,k))
+	  if( lb < lmax ) wbot = wbot + 0.5d0*(wlov(lb,k)+wlnv(lb,k))
+	end do
+	wtop = wtop/3.d0 - sv
+	wbot = wbot/3.d0 - sv
+
+	end
