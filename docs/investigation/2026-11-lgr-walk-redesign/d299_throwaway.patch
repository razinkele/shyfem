 !**********************************************************************
 
+
+!******************************************************************
+
+	subroutine lgr_dbg299(mode)
+
+! throwaway diagnostic #299 (never committed). mode 0: once, before the
+! first particle step, allocates the arrays and reads SHYFEM_D299_WLIN
+! (1: the variant of track_xi, d299_mode 1); mode 1: after each particle
+! step, adds the bottom layer's layer-mean w (as track_xi_get_vertical
+! gives it), |w|, the element-mean interface w at its top and |w| times
+! the time step, and every full hour writes them with the held/lifted
+! counters of track_xi to d299.txt (main thread, serial runs only)
+
+	use mod_lagrange
+	use mod_hydro_vel, only : wlov, wlnv
+	use levels, only : ilhv
+	use basin, only : nel, nen3v
+	use mod_lagrange_mpi, only : lgr_ieltv
+
+	implicit none
+
+	integer, intent(in) :: mode
+
+	integer, save :: iu = 0
+	integer ie,ii,k,lmax,ierr
+	real dt
+	double precision dtime,wt,wbot,wb,f
+	integer nb
+	logical bwall
+	character(len=16) :: env
+
+	if( mode == 0 ) then
+	  if( allocated(d299_w) ) return
+	  allocate(d299_w(7,nel),d299_n(4,nel),stat=ierr)
+	  if( ierr /= 0 ) call shympi_abort_internal('lgr_dbg299: allocation')
+	  d299_w = 0.d0
+	  d299_n = 0
+	  env = ' '
+	  call get_environment_variable('SHYFEM_D299_WLIN',env)
+	  if( env == '1' ) d299_mode = 1
+	  if( env == '2' ) d299_mode = 2
+	  open(newunit=iu,file='d299.txt',status='replace',iostat=ierr)
+	  if( ierr /= 0 ) call shympi_abort_internal('lgr_dbg299: open')
+	  write(6,*) 'd299: throwaway diagnostic, variant mode ',d299_mode
+	  return
+	end if
+
+	call get_timestep(dt)
+	call get_act_dtime(dtime)
+	do ie=1,nel
+	  lmax = ilhv(ie)
+	  if( lmax < 2 ) cycle
+	  wt = 0.d0
+	  wbot = 0.d0
+	  do ii=1,3
+	    k = nen3v(ii,ie)
+	    wt = wt + 0.5d0*(wlov(lmax-1,k)+wlnv(lmax-1,k))
+	    wbot = wbot + 0.5d0*(wlov(lmax,k)+wlnv(lmax,k))
+	  end do
+	  wt = wt/3.d0
+	  wbot = wbot/3.d0
+	  wb = 0.5d0*(wt+wbot)
+	  d299_w(1,ie) = d299_w(1,ie) + wb*dt
+	  d299_w(2,ie) = d299_w(2,ie) + abs(wb)*dt
+	  d299_w(3,ie) = d299_w(3,ie) + wt*dt
+	  d299_w(4,ie) = d299_w(4,ie) + abs(wt)*dt
+	  ! flux3d of the bottom layer over sides whose neighbour lacks the
+	  ! layer (a wall in z): inflow, outflow; and the inflow over all
+	  ! other sides (flux3d > 0 into the element)
+	  do ii=1,3
+	    nb = lgr_ieltv(ii,ie)
+	    f = flux3d(lmax,ii,ie)
+	    bwall = .false.
+	    if( nb > 0 ) bwall = ilhv(nb) < lmax
+	    if( bwall ) then
+	      d299_w(5,ie) = d299_w(5,ie) + max(f,0.d0)*dt
+	      d299_w(6,ie) = d299_w(6,ie) + max(-f,0.d0)*dt
+	    else if( nb /= 0 ) then
+	      d299_w(7,ie) = d299_w(7,ie) + max(f,0.d0)*dt
+	    end if
+	  end do
+	end do
+
+	if( mod(nint(dtime),3600) == 0 ) then
+	  write(iu,'(a,f12.1)') 'time ',dtime
+	  do ie=1,nel
+	    write(iu,'(i6,i4,7es14.6,4i10)') ie,ilhv(ie),d299_w(:,ie)	&
+     &				,d299_n(:,ie)
+	  end do
+	  flush(iu)
+	end if
+
+	end
