+!**************************************************************
+
+	subroutine keps_diag_init
+	use mod_keps
+	use para
+	implicit none
+	character(len=16) :: s
+	if( keps_diag >= 0 ) return
+	call get_environment_variable('SHYFEM_KEPS_DIAG',s)
+	keps_diag = 0
+	if( s /= ' ' ) read(s,*) keps_diag
+	keps_z0b = getpar('czdef')
+	if( keps_diag /= 0 ) write(6,*) 'KEPS_DIAG active: ',keps_diag,keps_z0b
+	end
+
 !**************************************************************
 
         subroutine keps_init
