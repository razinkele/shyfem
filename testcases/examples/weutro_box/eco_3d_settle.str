
#------------------------------------------------------------------------
# weutro 3D settling test (TR-05): no light (PHYT ~uniform without settling),
# phytoplankton settling ON via wsphyt -> PHYT must redistribute downward
# (deep layer > surface). Build with ECOLOGICAL=EUTRO; run after `make init`.
#------------------------------------------------------------------------

$title
        weutro 3D settling test
        eco_3d_settle
        GRID/MM_coarse
$end

$para
        itanf = '2009-01-01'    itend = '2009-01-03'
        idt = '300s'
        date = 20090101
        ilin = 1
        ibio = 1
        wsphyt = 1.e-4        # phytoplankton settling velocity [m/s] (~8.6 m/d)
        idtcon = '3h'
$end

$levels
        2 4 6 8 10 15 20 30 40 50 60 80
$end
