
#------------------------------------------------------------------------
# Minimal EUTRO (weutro) ecological smoke test - 2D closed basin
# Phase 0.2 of docs/plans/2026-06-03-weutro-eco-fixes-plan.md
# Closed basin (no open boundaries / no forcing); self-contained bio ICs
# come from the hardcoded einit defaults in bio3d.f90. Build with
#   make fem ECOLOGICAL=EUTRO
# Run with
#   PATH=/home/razinka/shyfem/bin:$PATH shyfem eco_3d.str
#------------------------------------------------------------------------

$title
        weutro 3D multi-layer eco test
        eco_3d
        GRID/MM_coarse
$end

$para
        itanf = '2009-01-01'    itend = '2009-01-03'
        idt = '300s'

        date = 20090101

        ilin = 1

        ibio = 1              # enable EUTRO biological reactor

        idtcon = '3h'         # scalar (bio) output interval
        idtout = '3h'
$end

$levels
        2 4 6 8 10 15 20 30 40 50 60 80
$end
