  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ \"$CLAUDE_FILE_PATH\" == *.py ]]; then ruff format --quiet \"$CLAUDE_FILE_PATH\" 2>/dev/null; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ \"$CLAUDE_FILE_PATH\" == *.env ]] || [[ \"$CLAUDE_FILE_PATH\" == *.env.* ]]; then echo 'BLOCKED: .env files contain secrets - edit manually' >&2; exit 2; fi"
          }
        ]
      }
    ]
  }
