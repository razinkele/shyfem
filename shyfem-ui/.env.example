# SHYFEM UI Configuration
# Copy this file to .env and update the values for your deployment.
# All variables are prefixed with SHYFEM_UI_ and are case-insensitive.

# Deployment mode: 'local' for single-user desktop, 'server' for multi-user
SHYFEM_UI_DEPLOYMENT_MODE=local

# Database URL (SQLite for local, PostgreSQL recommended for server)
SHYFEM_UI_DATABASE_URL=sqlite:///./shyfem_ui.db

# Path to the SHYFEM installation directory
# SHYFEM_UI_SHYFEM_DIR=/path/to/shyfem

# Working directory for user projects
# SHYFEM_UI_WORK_DIR=~/.shyfem-ui/projects

# Per-user data directory root (server mode)
# SHYFEM_UI_USER_DATA_ROOT=/data/shyfem

# --- Authentication (server mode) ---
# Auth is auto-enabled in server mode. Set to 'false' to explicitly disable.
# SHYFEM_UI_AUTH_ENABLED=
# IMPORTANT: Use strong, unique passwords in production!
SHYFEM_UI_DEFAULT_ADMIN_PASSWORD=
SHYFEM_UI_DEFAULT_USER_PASSWORD=

# --- Reverse proxy (server mode) ---
# Set root_path when deployed behind a reverse proxy (e.g., nginx)
# SHYFEM_UI_ROOT_PATH=/shyfem-ui

# --- SMTP notifications (optional) ---
# SHYFEM_UI_SMTP_HOST=
# SHYFEM_UI_SMTP_PORT=587
# SHYFEM_UI_SMTP_USER=
# SHYFEM_UI_SMTP_PASSWORD=
# SHYFEM_UI_SMTP_FROM=SHYFEM UI <noreply@localhost>
